# Quickstart configuration. Copy to `.env` and edit:
#
#   cp .env.example .env
#
# `.env` is gitignored — your real keys never get committed.

# ── Upstream provider credentials ───────────────────────────────────────────
# Replace these placeholders with your real keys. Each is substituted into the
# gateway's rendered policy.yaml at startup. You only need the keys for the
# providers you actually call.
OPENAI_API_KEY=sk-replace-with-your-openai-key
ANTHROPIC_API_KEY=sk-ant-replace-with-your-anthropic-key
GEMINI_API_KEY=replace-with-your-gemini-key

# ── Client-facing key ───────────────────────────────────────────────────────
# The Sluice key your SDK/clients send (Authorization: Bearer <this>, or the
# provider-native x-api-key / x-goog-api-key header). The gateway swaps in the
# upstream credential above. Change it for anything beyond local testing.
SLUICE_CLIENT_API_KEY=sk_quickstart_demo_key

# ── Admin console (admin + telemetry stacks) ────────────────────────────────
# Console login is always user "admin"; this is the password.
SLUICE_ADMIN_PASSWORD=sluice-gateway

# ── Images / logging ────────────────────────────────────────────────────────
# Pin to a release (e.g. v1.1.18) instead of latest for reproducible deploys.
SLUICE_IMAGE_TAG=latest
SLUICE_LOG_LEVEL=info

# ── Full Record/audit feed (telemetry stack, optional) ──────────────────────
# The telemetry stack ships OTLP-only by default. To also push the full
# per-request Record (bodies, headers, rule chain) to the telemetry service's
# message inspector, follow "Full Record feed" in README.md and set a shared
# HMAC secret here (must match the gateways: entry in config/telemetry.yaml):
# SLUICE_TELEMETRY_HMAC_SECRET=change-me-shared-hmac-secret
# SLUICE_WEBHOOK_ALLOW_PRIVATE=true
