# syntax=docker/dockerfile:1.7

ARG VERSION=dev

FROM alpine:3 AS certs
RUN apk add --no-cache ca-certificates

# Stage 1: build the control-plane console SPA. vite.cp.config.ts emits to
# ../internal/controlplane/webdist (→ /internal/controlplane/webdist from this
# WORKDIR); the entry is index.cp.html, so rename to index.html for the Go
# static handler, then stage at /out/webdist for an unambiguous COPY.
FROM node:22-alpine AS spa-builder
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --silent
COPY web/ ./
RUN npm run build:cp \
    && mv /internal/controlplane/webdist/index.cp.html /internal/controlplane/webdist/index.html \
    && mkdir -p /out && mv /internal/controlplane/webdist /out/webdist

FROM golang:1.25-alpine AS builder
ARG VERSION
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Overlay the freshly-built SPA bundle on top of the committed placeholder.html
# so go:embed sees the real console assets.
COPY --from=spa-builder /out/webdist/ /src/internal/controlplane/webdist/
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w -X github.com/andyjmorgan/sluice-gateway/internal/version.Version=${VERSION}" \
    -o /out/controlplane \
    ./cmd/api

FROM scratch
ARG VERSION
LABEL org.opencontainers.image.title="sluice-controlplane" \
      org.opencontainers.image.description="Central control plane for sluice-gateway: fleet registry (gRPC) + fleet console (HTTP)." \
      org.opencontainers.image.source="https://github.com/andyjmorgan/sluice-gateway" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=builder /out/controlplane /controlplane
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# 8484: HTTP API + console (/healthz, /api/v1/*, SPA). 8485: gRPC fleet channel.
EXPOSE 8484 8485
USER 65532:65532
ENTRYPOINT ["/controlplane"]
CMD []
