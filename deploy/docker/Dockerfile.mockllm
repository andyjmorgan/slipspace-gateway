ARG VERSION=dev

FROM alpine:3 AS certs
RUN apk add --no-cache ca-certificates

FROM golang:1.25-alpine AS builder
ARG VERSION
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w -X github.com/andyjmorgan/slipspace-gateway/internal/version.Version=${VERSION}" \
    -o /out/mockllm \
    ./cmd/mockllm

FROM scratch
ARG VERSION
LABEL org.opencontainers.image.title="sluice-mockllm" \
      org.opencontainers.image.description="Mock LLM upstream for sluice-gateway development and end-to-end testing." \
      org.opencontainers.image.source="https://github.com/andyjmorgan/slipspace-gateway" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=builder /out/mockllm /mockllm
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
EXPOSE 5555
USER 65532:65532
ENTRYPOINT ["/mockllm"]
CMD []
